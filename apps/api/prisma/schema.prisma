generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Foyer & comptes
// ---------------------------------------------------------------------------

model Household {
  id        String   @id @default(uuid())
  name      String
  currencyName String @default("Pièces")
  /// Renseigné quand le parent a terminé l'accueil (prénom, nom de la famille, enfants).
  onboardingCompletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   HouseholdMembership[]
  children      ChildProfile[]
  quests        Quest[]
  rewards       Reward[]
  universeGrants HouseholdUniverse[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships HouseholdMembership[]
  createdQuests Quest[] @relation("QuestCreator")
  auditLogs   AuditLog[]
}

enum HouseholdRole {
  PARENT_ADMIN
  PARENT
}

model HouseholdMembership {
  id          String        @id @default(uuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        HouseholdRole @default(PARENT)
  createdAt   DateTime      @default(now())

  @@unique([householdId, userId])
}

enum AgeBand {
  AGE_8_9
  AGE_10_12
}

/// Niveau pédagogique choisi par le parent (docs/FINANCIAL_EDUCATION.md §4.1) : prioritaire sur l'âge.
enum PedagogyLevel {
  AUTO
  DECOUVERTE
  APPROFONDI
}

model ChildProfile {
  id          String   @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  displayName String
  ageBand     AgeBand
  /// AUTO : la tranche d'âge décide ; sinon Découverte (8-9) ou Approfondi (10-12).
  pedagogyLevel PedagogyLevel @default(AUTO)
  avatarId    String
  pinHash     String
  currentXp   Int      @default(0)
  currentLevel Int     @default(1)
  activeGoalId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet          Wallet?
  quests          Quest[]
  questCompletions QuestCompletion[]
  redemptions     RewardRedemption[]
  savingsGoals    SavingsGoal[]
  xpTransactions  XpTransaction[]
  childBadges     ChildBadge[]
  boosterInstances BoosterInstance[]
  childCards      ChildCard[]
  learningProgress LearningProgress[]
  notifications   Notification[]
  vaultRule       VaultRule?
  vaultRequests   VaultWithdrawalRequest[]
  investSettings  InvestSettings?
  simulationRuns  SimulationRun[]
  financeNotions  FinanceNotionProgress[]
  investPauses    InvestPause[]
  allowance       AllowanceSchedule?
  financeTips     FinanceTipLog[]

  @@index([householdId])
}

// ---------------------------------------------------------------------------
// Portefeuille & ledger
// ---------------------------------------------------------------------------

model Wallet {
  id        String   @id @default(uuid())
  childId   String   @unique
  child     ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  transactions WalletTransaction[]
}

enum WalletTransactionType {
  QUEST_REWARD
  PARENT_BONUS
  PARENT_ADJUSTMENT
  REWARD_PURCHASE
  REWARD_REFUND
  SAVINGS_LOCK
  SAVINGS_UNLOCK
  SAVINGS_BONUS
  /// Argent de poche (versement régulier du parent, éventuellement automatique chaque semaine).
  ALLOWANCE
  /// Cadeau reçu (anniversaire, fête…) : la raison dit de qui et pourquoi.
  GIFT
}

/// Argent de poche automatique : un versement chaque semaine, rattrapé à la lecture du compte
/// (clé d'idempotence par date), jamais en double. Arrêtable par le parent.
model AllowanceSchedule {
  childId     String   @id
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  amount      Int
  /// Jour de la semaine (1 = lundi … 7 = dimanche), à 8 h (heure de Paris).
  weekday     Int
  active      Boolean  @default(true)
  /// Premier versement possible : à partir de ce moment (pas de rattrapage avant).
  startsAt    DateTime @default(now())
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model WalletTransaction {
  id             String   @id @default(uuid())
  walletId       String
  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount         Int      // toujours positif ; l'effet sur le solde disponible / le coffre est déterminé par `type` (voir lib/ledger.ts)
  type           WalletTransactionType
  /// Uniquement significatif pour PARENT_ADJUSTMENT (les autres types ont un sens fixe) : "credit" ou "debit".
  direction      String?
  sourceType     String?  // ex: "quest_completion", "reward_redemption", "savings_goal"
  sourceId       String?
  actorId        String   // userId (parent) ou childId (enfant) à l'origine de l'action
  reason         String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([walletId, createdAt])
}

// ---------------------------------------------------------------------------
// Quêtes
// ---------------------------------------------------------------------------

enum QuestCategory {
  MAISON
  AUTONOMIE
  APPRENTISSAGE
  ENTRAIDE
  CREATIVITE
  ECOLE
  JARDIN
  ANIMAUX
}

enum QuestDifficulty {
  FACILE
  MOYENNE
  IMPORTANTE
  EXCEPTIONNELLE
}

enum QuestRecurrence {
  UNIQUE
  QUOTIDIENNE
  HEBDOMADAIRE
}

enum QuestStatus {
  DISPONIBLE
  ACCEPTEE
  EN_COURS
  DECLAREE_TERMINEE
  EN_ATTENTE_VALIDATION
  VALIDEE
  A_REFAIRE
  REFUSEE
}

model Quest {
  id                String   @id @default(uuid())
  householdId       String
  household         Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  creatorId         String
  creator           User     @relation("QuestCreator", fields: [creatorId], references: [id])
  childId           String
  child             ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  title             String
  description       String?
  category          QuestCategory
  difficulty        QuestDifficulty @default(FACILE)
  rewardCoins       Int      @default(0)
  rewardXp          Int      @default(0)
  boosterDefinitionId String?
  boosterDefinition BoosterDefinition? @relation(fields: [boosterDefinitionId], references: [id])
  recurrence        QuestRecurrence @default(UNIQUE)
  dueAt             DateTime?
  validationRequired Boolean @default(true)
  active            Boolean  @default(true)
  status            QuestStatus @default(DISPONIBLE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  completions QuestCompletion[]

  @@index([householdId])
  @@index([childId, status])
}

enum QuestCompletionStatus {
  EN_ATTENTE
  VALIDEE
  A_REFAIRE
  REFUSEE
}

model QuestCompletion {
  id           String   @id @default(uuid())
  questId      String
  quest        Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  declaredAt   DateTime @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  status       QuestCompletionStatus @default(EN_ATTENTE)
  note         String?

  @@index([questId])
  @@index([childId, status])
}

// ---------------------------------------------------------------------------
// Boutique / récompenses
// ---------------------------------------------------------------------------

enum RewardCategory {
  EXPERIENCE
  OBJET
}

model Reward {
  id                 String   @id @default(uuid())
  householdId        String
  household          Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  imageUrl           String?
  category           RewardCategory
  priceCoins         Int
  allowedChildIds     String[] // vide = tous les enfants du foyer
  quantityAvailable  Int?     // null = illimité
  cooldownHours      Int?
  active             Boolean  @default(true)
  expiresAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  redemptions RewardRedemption[]

  @@index([householdId])
}

enum RedemptionStatus {
  DEMANDEE
  ACCEPTEE
  A_UTILISER
  UTILISEE
  REFUSEE
}

model RewardRedemption {
  id           String   @id @default(uuid())
  rewardId     String
  reward       Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  priceCoinsAtPurchase Int
  status       RedemptionStatus @default(DEMANDEE)
  requestedAt  DateTime @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  usedAt       DateTime?

  @@index([rewardId])
  @@index([childId, status])
}

// ---------------------------------------------------------------------------
// Épargne (coffre)
// ---------------------------------------------------------------------------

model SavingsGoal {
  id           String   @id @default(uuid())
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  title        String
  targetCoins  Int
  rewardId     String?
  /// Ordre de remplissage : Mon coffre remplit les objectifs l'un après l'autre (le plus petit d'abord).
  position     Int      @default(0)
  achievedAt   DateTime?
  /// Objectif rangé par l'enfant (utilisé ou abandonné) : il ne compte plus dans le remplissage.
  archivedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([childId])
}

/// Règle de retrait de Mon coffre, fixée par un parent pour un enfant.
enum VaultRuleMode {
  FREE
  PARENT_APPROVAL
  MIN_DAYS
  GOAL_ONLY
}

model VaultRule {
  childId     String   @id
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  mode        VaultRuleMode @default(FREE)
  /// Pour MIN_DAYS : nombre de jours pendant lesquels chaque dépôt reste dans le coffre.
  minDays     Int?
  /// Entrée en vigueur : les pièces déposées avant restent libres (on ne change pas les règles d'un dépôt déjà fait).
  since       DateTime @default(now())
  updatedById String?
  updatedAt   DateTime @updatedAt
}

enum VaultRequestStatus {
  PENDING
  APPROVED
  REFUSED
}

/// Demande de retrait du coffre, quand la règle demande la validation d'un parent.
model VaultWithdrawalRequest {
  id             String   @id @default(uuid())
  childId        String
  child          ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  amount         Int
  status         VaultRequestStatus @default(PENDING)
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  decidedAt      DateTime?
  decidedById    String?

  @@index([childId, status])
}

// ---------------------------------------------------------------------------
// XP / niveaux / badges
// ---------------------------------------------------------------------------

enum XpSourceType {
  QUEST
  SAVINGS_GOAL
  LEARNING_MODULE
  COLLECTION
  BADGE
  LEVEL_UP_BONUS
  /// Placements école : première répartition, bilan final d'une partie lu (jamais lié au résultat).
  FINANCE_LEARNING
}

model XpTransaction {
  id         String   @id @default(uuid())
  childId    String
  child      ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  amount     Int
  sourceType XpSourceType
  sourceId   String?
  idempotencyKey String @unique
  createdAt  DateTime @default(now())

  @@index([childId, createdAt])
}

model Badge {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String
  iconUrl     String?
  createdAt   DateTime @default(now())

  childBadges ChildBadge[]
}

model ChildBadge {
  id        String   @id @default(uuid())
  childId   String
  child     ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  @@unique([childId, badgeId])
}

// ---------------------------------------------------------------------------
// Univers, cartes, boosters
// ---------------------------------------------------------------------------

model Universe {
  id           String   @id @default(uuid())
  code         String   @unique
  title        String
  description  String?
  coverImageUrl String?
  isLicensed   Boolean  @default(false)
  licensor     String?
  licenseId    String?
  licenseStartsAt DateTime?
  licenseEndsAt   DateTime?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)

  series   CollectionSeries[]
  cards    Card[]
  boosterDefinitions BoosterDefinition[]
  householdGrants HouseholdUniverse[]
}

model HouseholdUniverse {
  id          String   @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  universeId  String
  universe    Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  enabledAt   DateTime @default(now())

  @@unique([householdId, universeId])
}

model CollectionSeries {
  id         String   @id @default(uuid())
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  title      String
  sortOrder  Int      @default(0)

  cards Card[]
}

enum CardRarity {
  COMMUNE
  PEU_COMMUNE
  RARE
  EPIQUE
  LEGENDAIRE
}

model Card {
  id              String   @id @default(uuid())
  universeId      String
  universe        Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  seriesId        String?
  series          CollectionSeries? @relation(fields: [seriesId], references: [id])
  cardNumber      Int
  name            String
  rarity          CardRarity
  category        String?
  description     String?
  educationalFact String?
  artworkUrl      String?
  active          Boolean  @default(true)

  childCards ChildCard[]

  @@unique([universeId, cardNumber])
  @@index([universeId, rarity])
}

model ChildCard {
  id          String   @id @default(uuid())
  childId     String
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  quantity    Int      @default(1)
  firstObtainedAt DateTime @default(now())
  lastObtainedAt  DateTime @default(now())

  @@unique([childId, cardId])
  @@index([childId])
}

model BoosterDefinition {
  id            String   @id @default(uuid())
  universeId    String
  universe      Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  code          String   @unique
  title         String
  cardCount     Int      @default(5)
  rngVersion    String   @default("v1")
  // configuration des probabilités par emplacement, versionnée et sérialisée en JSON
  slotConfig    Json

  quests   Quest[]
  instances BoosterInstance[]
}

enum BoosterInstanceStatus {
  NON_OUVERT
  OUVERT
}

model BoosterInstance {
  id           String   @id @default(uuid())
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  definitionId String
  definition   BoosterDefinition @relation(fields: [definitionId], references: [id])
  sourceType   String   // "quest_reward" | "level_up" | "savings_goal" | "badge" | "parent_grant"
  sourceId     String?
  status       BoosterInstanceStatus @default(NON_OUVERT)
  grantedAt    DateTime @default(now())
  openedAt     DateTime?

  opening BoosterOpening?

  @@index([childId, status])
}

model BoosterOpening {
  id           String   @id @default(uuid())
  boosterInstanceId String @unique
  boosterInstance BoosterInstance @relation(fields: [boosterInstanceId], references: [id], onDelete: Cascade)
  childId      String
  rngVersion   String
  rngSeed      String
  resultCardIds String[]
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Éducation financière
// ---------------------------------------------------------------------------

enum LearningAgeBand {
  AGE_8_9
  AGE_10_12
  ALL
}

model LearningModule {
  id          String   @id @default(uuid())
  code        String   @unique
  order       Int
  title       String
  subtitle    String
  ageBand     LearningAgeBand @default(ALL)
  content     Json     // situation / choix / conséquence / explication / mini-question
  rewardXp    Int      @default(20)
  active      Boolean  @default(true)

  progress LearningProgress[]
}

enum LearningProgressStatus {
  NON_COMMENCE
  EN_COURS
  TERMINE
}

model LearningProgress {
  id          String   @id @default(uuid())
  childId     String
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  moduleId    String
  module      LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status      LearningProgressStatus @default(NON_COMMENCE)
  completedAt DateTime?

  @@unique([childId, moduleId])
}

// ---------------------------------------------------------------------------
// Éducation financière : notions, encarts et vérifications (docs/FINANCIAL_EDUCATION.md)
// ---------------------------------------------------------------------------

enum FinanceNotionState {
  RENCONTREE
  EXPLIQUEE
  VERIFIEE
}

/// Progression d'une notion : rencontrée (événement vécu) → expliquée (encart lu) → vérifiée (bonne réponse).
model FinanceNotionProgress {
  childId       String
  child         ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  notionCode    String
  state         FinanceNotionState @default(RENCONTREE)
  encounteredAt DateTime @default(now())
  explainedAt   DateTime?
  verifiedAt    DateTime?
  /// Souvenir personnel affiché dans le carnet (« Relevé de l'année 2 : Entreprises −6 »).
  anchor        String?

  @@id([childId, notionCode])
}

/// Journal des encarts : chacun ne s'affiche qu'une fois par enfant, puis reste relisible (§5.1).
model FinanceTipLog {
  childId  String
  child    ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  tipCode  String
  /// « compris » ou « plus_tard ».
  outcome  String
  title    String?
  message  String
  shownAt  DateTime @default(now())

  @@id([childId, tipCode])
}

// ---------------------------------------------------------------------------
// Notifications & audit
// ---------------------------------------------------------------------------

enum NotificationAudience {
  PARENT
  CHILD
}

model Notification {
  id          String   @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  audience    NotificationAudience
  childId     String?
  child       ChildProfile? @relation(fields: [childId], references: [id], onDelete: Cascade)
  type        String
  payload     Json
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([householdId, audience, childId])
}

model AuditLog {
  id          String   @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([householdId, createdAt])
}

/// Essais de connexion par clé (`parent:{email}`, `child-pin:{childId}`), en base car l'API tourne
/// en serverless : un compteur en mémoire repartirait de zéro à chaque instance. Supprimé au succès.
model AuthThrottle {
  key             String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  /// Fin du dernier blocage (conservée après son expiration pour oublier les blocages anciens).
  lockedUntil     DateTime?
  /// Blocages consécutifs : chacun double la durée du suivant, jusqu'au plafond de la règle.
  lockouts        Int       @default(0)
  updatedAt       DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Placements école (moteur finsim) : unités école uniquement, jamais des pièces.
// Voir docs/FINANCIAL_SIMULATION_ENGINE.md §10 et docs/INVESTMENT_UX.md.
// ---------------------------------------------------------------------------

enum SimRhythm {
  RAPIDE
  STANDARD
  LONG
}

enum SimRunStatus {
  EN_COURS
  TERMINEE
  ARRETEE
}

/// MIROIR : l'observatoire (sans frais). ASSURANCE_VIE : le verger du temps long (10-12 ans, frais d'exemple).
enum SimMode {
  MIROIR
  ASSURANCE_VIE
}

/// Réglages parent des placements école d'un enfant.
model InvestSettings {
  childId       String   @id
  child         ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  enabled       Boolean  @default(true)
  rhythm        SimRhythm @default(STANDARD)
  /// Durée d'une partie en mois simulés (24 à 120).
  horizonMonths Int      @default(60)
  /// Versements programmés dans l'observatoire (Approfondi) et plafond du capital école, départ compris.
  contributionsEnabled Boolean @default(false)
  contributionCap      Int     @default(300)
  updatedById   String?
  updatedAt     DateTime @updatedAt
}

/// Pause parentale (vacances) : les relevés prévus pendant la pause sont sautés, jamais rattrapés.
model InvestPause {
  id          String   @id @default(uuid())
  childId     String
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  from        DateTime @default(now())
  /// Fin de la pause ; nulle tant que l'observatoire est en pause.
  to          DateTime?
  createdById String?

  @@index([childId])
}

/// Une partie de simulation : trajectoire de marché figée à la création (jamais envoyée au client).
model SimulationRun {
  id                    String   @id @default(uuid())
  childId               String
  child                 ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  householdId           String
  mode                  SimMode  @default(MIROIR)
  /// Plafond de capital école (versements cumulés), ASSURANCE_VIE uniquement.
  contributionCap       Int?
  engineVersion         String
  parametersFingerprint String
  seed                  String
  scenario              String
  horizonMonths         Int
  rhythm                SimRhythm
  timeZone              String   @default("Europe/Paris")
  startedAt             DateTime @default(now())
  fees                  Json
  marketPath            Json
  status                SimRunStatus @default(EN_COURS)
  finishedAt            DateTime?
  /// Clé d'idempotence de la validation de la première répartition.
  idempotencyKey        String   @unique
  createdAt             DateTime @default(now())

  operations SimulationOperation[]
  snapshots  SimulationSnapshot[]

  @@index([childId, mode, status])
}

/// Journal immuable des décisions de l'enfant (versement initial, arbitrages…).
model SimulationOperation {
  id             String   @id @default(uuid())
  runId          String
  run            SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  step           Int
  type           String
  amount         Float?
  amountPerMonth Float?
  allocation     Json?
  actorId        String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([runId, step])
}

/// Relevé : ce que l'enfant a découvert à un rendez-vous. Jamais recalculé ni réécrit.
model SimulationSnapshot {
  id              String   @id @default(uuid())
  runId           String
  run             SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  rendezVousIndex Int
  step            Int
  scheduledAt     DateTime
  valueAtReveal   Float
  bySupport       Json
  contributed     Float
  performanceIndex Float
  priceIndex      Float
  seenAt          DateTime?
  computedAt      DateTime @default(now())

  @@unique([runId, rendezVousIndex])
}

