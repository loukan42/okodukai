DATABASE_URL="postgresql://okodukai:okodukai@localhost:5432/okodukai?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
GOOGLE_CLIENT_ID=""
# Notifications « Ton relevé est prêt. » (facultatif) : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="https://okodukai-gold.vercel.app"
# Secret de la tâche planifiée /internal/cron/statements (Vercel Cron)
CRON_SECRET=
# Secret partagé avec le projet web : adresse du visiteur signée par le relais (limite des essais par adresse)
PROXY_SECRET=
# Seul compte pouvant recevoir l'administration globale (admin:grant, admin:bootstrap-local)
PLATFORM_ADMIN_EMAIL=
